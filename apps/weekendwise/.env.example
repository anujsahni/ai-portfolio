# WeekendWise private settings. Copy to .env and fill in. Never commit .env.

# Guide 00 / MVP-01 (from `make bootstrap` output)
GCP_PROJECT_ID=
GCP_REGION=us-central1
BUDGET_USD=20

# MVP-02: Vertex AI (verified available on 2026-11-06)
# Gemini models are served from the global endpoint; embeddings from the region.
VERTEX_GENERATION_MODEL_ID=gemini-3.8-flash
VERTEX_GENERATION_LOCATION=global
VERTEX_THINKING_LEVEL=LOW
VERTEX_EMBEDDING_MODEL_ID=gemini-embedding-001
VERTEX_EMBEDDING_LOCATION=us-central1
VERTEX_EMBEDDING_DIMENSION=768

# Limits on every model call
MAX_PROMPT_CHARS=24000
MAX_OUTPUT_TOKENS=4096
MAX_EMBEDDING_BATCH=50
REQUEST_TIMEOUT_SECONDS=45
MODEL_RETRY_ATTEMPTS=1

# Guide 04 / MVP-05: Firestore retrieval
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_COLLECTION=guide_chunks
SUPPORTED_CITY_IDS=san-francisco,portland,santa-cruz,napa-valley
RETRIEVAL_TOP_K=4
RETRIEVAL_MAX_TOP_K=5
# Cosine distance cut-off, calibrated 2026-11-06 with scripts/check_retrieval.py --calibrate
# (expected matches ≤ 0.306, off-topic ≥ 0.386). Re-calibrate if the model or guides change.
RETRIEVAL_MAX_DISTANCE=0.34
FIRESTORE_TIMEOUT_SECONDS=10
SOURCE_STALE_AFTER_DAYS=365
