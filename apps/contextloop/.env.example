# Copy to .env (git-ignored). Replay mode needs nothing else.
# Keep comments on their own lines: Docker Compose reads text after a value as part of it.

# replay (default: plays recorded agent runs, no key needed) or live (calls Claude now)
CONTEXTLOOP_MODE=replay

# Live mode and `make record` only. An Anthropic API key from console.anthropic.com; it starts with sk-ant-api03-
ANTHROPIC_API_KEY=

# The Claude model both agents use. claude-opus-5-5 (default, most capable), claude-sonnet-5-5 (about half the cost)
# or claude-haiku-5-5 (about 1/40 of the cost; check that the governed agent still scores 5 or 6 out of 6).
CONTEXTLOOP_MODEL=claude-opus-5-5
# YouTube link of the narrated pitch video, shown on the Architecture page (optional; overrides the link in config.py)
CONTEXTLOOP_PITCH_URL=

# How many times `make record` runs each agent on each question (3 for the full evaluation, 1 for a quick pass)
CONTEXTLOOP_EVAL_RUNS=3

# Optional, Act 5: a Slack incoming-webhook URL (https://hooks.slack.com/...). Empty = preview only.
SLACK_WEBHOOK_URL=

# Local-only demo credentials for the private Docker network (never real secrets).
POSTGRES_PASSWORD=contextloop-demo
S3_ACCESS_KEY=contextloop
S3_SECRET_KEY=contextloop-demo-secret

# Scenario T6: 1 = hold Zendesk's last sync two days behind (the default for the demo), 0 = all sources current
CONTEXTLOOP_T6_STALE_ZENDESK=1

# Optional, for a natural-sounding pitch video narration (make pitch-video ARGS='--tts elevenlabs' or '--tts openai')
GOOGLE_TTS_PROJECT=          # Google Chirp 3 HD via your gcloud login (or GOOGLE_TTS_API_KEY=)
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
