  "VBRP": {"_table": "Billing document item", "VBELN": "Billing document number", "POSNR": "Item number", "MATNR": "Material number", "NETWR": "Net item value", "VGBEL": "Reference document (delivery or invoice)", "AUBEL": "Sales order", "ERDAT": "Created on"},
  "TCURR": {"_table": "Exchange rates", "KURST": "Rate type (M = monthly average)", "FCURR": "From currency", "TCURR": "To currency", "GDATU": "Valid from, stored inverted (99999999 - YYYYMMDD)", "UKURS": "Exchange rate"},
