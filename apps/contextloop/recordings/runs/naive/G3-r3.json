    {
      "tool": "run_sql",
      "input": {
        "purpose": "Check whether billing headers are duplicated across synced loads and how the Salesforce account mapping behaves (active vs history rows)",
        "sql": "SELECT (SELECT count(*) - count(DISTINCT vbeln) FROM sap_s4.vbrk) AS dup_vbrk, (SELECT count(*) - count(DISTINCT sap_customer_number_c) FROM salesforce.account WHERE _fivetran_active) AS dup_sf_active, (SELECT count(*) FROM salesforce.account) AS sf_rows, (SELECT count(*) FROM salesforce.account WHERE _fivetran_active) AS sf_active, (SELECT count(*) FROM sap_s4.kna_1) AS kna_rows, (SELECT count(DISTINCT kunag) FROM sap_s4.vbrk WHERE kunag NOT IN (SELECT kunnr FROM sap_s4.kna_1)) AS unmatched_kunag"
      },
