    {
      "tool": "run_sql",
      "input": {
        "purpose": "Check Q3 2026 billing headers vs item totals and region coverage of billed customers",
        "sql": "WITH h AS (SELECT v.vbeln, v.fkart, v.waerk, v.fkdat, v.kunag, CAST(v.netwr AS DECIMAL(18,2)) AS netwr FROM sap_s4.vbrk v WHERE v.fkdat BETWEEN '20260701' AND '20260930' AND NOT v._fivetran_deleted), i AS (SELECT vbeln, sum(CAST(netwr AS DECIMAL(18,2))) AS item_netwr, count(*) AS items FROM sap_s4.vbrp WHERE NOT _fivetran_deleted GROUP BY 1) SELECT count(*) AS n_docs, sum(CASE WHEN i.vbeln IS NULL THEN 1 ELSE 0 END) AS no_items, sum(CASE WHEN abs(h.netwr - i.item_netwr) > 0.01 THEN 1 ELSE 0 END) AS mismatch_vs_items, sum(h.netwr) AS hdr_total FROM h LEFT JOIN i ON i.vbeln = h.vbeln"
      },
