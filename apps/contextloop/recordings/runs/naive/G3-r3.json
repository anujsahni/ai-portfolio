      "input": {
        "purpose": "Compute Q3 2026 EMEA net revenue in USD: invoices minus credit memos, EUR converted at the monthly M rate for the billing month, regions from Salesforce",
        "sql": "WITH rate AS (SELECT substr(CAST(try_strptime(lpad(CAST(99999999 - CAST(gdatu AS BIGINT) AS VARCHAR),8,'0'),'%Y%m%d') AS VARCHAR),1,7) AS ym, CAST(ukurs AS DECIMAL(18,6)) AS r FROM sap_s4.tcurr WHERE kurst='M' AND fcurr='EUR' AND tcurr='USD' AND NOT _fivetran_deleted),\nd AS (SELECT v.vbeln, v.fkart, v.waerk, v.fkdat, v.kunag, CAST(v.netwr AS DECIMAL(18,2)) AS netwr, a.region_c, try_strptime(v.fkdat,'%Y%m%d') AS fd FROM sap_s4.vbrk v JOIN salesforce.account a ON a.sap_customer_number_c = v.kunag AND a._fivetran_active WHERE v.fkdat BETWEEN '20260701' AND '20260930' AND NOT v._fivetran_deleted)\nSELECT d.region_c, d.fkart, d.waerk, count(*) AS docs, sum(d.netwr) AS local_amt, sum(CASE WHEN d.waerk='EUR' THEN d.netwr * r.r ELSE d.netwr END) AS usd_amt FROM d LEFT JOIN rate r ON r.ym = substr(CAST(d.fd AS VARCHAR),1,7) AND d.waerk='EUR' GROUP BY 1,2,3 ORDER BY 1,2,3"
      },
