        "sql": "WITH rates AS (\n  SELECT CAST(99999999 - CAST(gdatu AS INT) AS VARCHAR) AS valid_from, CAST(ukurs AS DECIMAL(18,5)) AS rate\n  FROM sap_s4.tcurr WHERE kurst='M' AND fcurr='EUR' AND tcurr='USD' AND NOT _fivetran_deleted),\nb AS (\n  SELECT v.vbeln, v.fkart, v.fkdat, v.waerk, CAST(v.netwr AS DECIMAL(18,2)) AS amt, v.kunag\n  FROM sap_s4.vbrk v WHERE v.fkdat >= '20260701' AND v.fkdat <= '20260930' AND NOT v._fivetran_deleted),\nc AS (\n  SELECT b.*, k.land_1,\n    CASE WHEN b.waerk='USD' THEN 1.0 ELSE (SELECT r.rate FROM rates r WHERE r.valid_from <= b.fkdat ORDER BY r.valid_from DESC LIMIT 1) END AS fx\n  FROM b LEFT JOIN sap_s4.kna_1 k ON k.kunnr=b.kunag AND NOT k._fivetran_deleted)\nSELECT land_1 AS country,\n  sum(CASE WHEN fkart='F2' THEN amt*fx ELSE 0 END) AS invoices_usd,\n  sum(CASE WHEN fkart='G2' THEN amt*fx ELSE 0 END) AS credits_usd,\n  sum(CASE WHEN fkart='F2' THEN amt*fx ELSE -amt*fx END) AS net_usd,\n  count(*) AS docs\nFROM c WHERE land_1 IN ('AT','DE','FR','GB','IT','NL','SE') GROUP BY ROLLUP(land_1) ORDER BY land_1\""
